    "start": "electron .",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "three": "^0.180.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^35.1.4",
    "vite": "^6.2.2",
    "wait-on": "^8.0.3"
  }
}
