{
  "name": "black-clover-desktop-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Windows AI desktop assistant with VRM avatar",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
